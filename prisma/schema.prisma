generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  RECEPTIONIST
  TEACHER
  ACCOUNTANT
}

enum EnquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  ADMITTED
  LOST
}

enum ExperienceLevel {
  NONE
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentType {
  REGISTRATION
  COURSE
  EVENT
  EXAM
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DROPPED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  courses     Course[]
  batches     Batch[]
  teachers    Teacher[]
  students    Student[]
  parents     Parent[]
  enquiries   Enquiry[]
  payments    Payment[]
  enrollments Enrollment[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String
  role           UserRole
  supabaseUserId String?      @unique
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Course {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      Batch[]

  @@unique([organizationId, id])
  @@index([organizationId])
}

model Teacher {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      Batch[]

  @@unique([organizationId, id])
  @@index([organizationId])
}

model Batch {
  id             String       @id @default(cuid())
  organizationId String
  courseId       String
  teacherId      String?
  name           String
  capacity       Int?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course        @relation(fields: [organizationId, courseId], references: [organizationId, id])
  teacher      Teacher?      @relation(fields: [organizationId, teacherId], references: [organizationId, id])
  enrollments  Enrollment[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([courseId])
  @@index([teacherId])
}

model Parent {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  phone          String
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students     Student[]
  enquiries    Enquiry[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([phone])
}

model Student {
  id             String       @id @default(cuid())
  organizationId String
  parentId       String?
  firstName      String
  lastName       String?
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  experience     ExperienceLevel?
  photoUrl       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Parent?      @relation(fields: [organizationId, parentId], references: [organizationId, id])
  payments     Payment[]
  enrollments  Enrollment[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([parentId])
}

model Enrollment {
  id             String           @id @default(cuid())
  organizationId String
  studentId      String
  batchId        String
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  endedAt        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [organizationId, studentId], references: [organizationId, id])
  batch        Batch        @relation(fields: [organizationId, batchId], references: [organizationId, id])

  @@unique([studentId, batchId])
  @@index([organizationId])
  @@index([studentId])
  @@index([batchId])
}

model Enquiry {
  id             String          @id @default(cuid())
  organizationId String
  parentId       String?
  studentName    String
  parentName     String?
  phone          String
  email          String?
  interestedIn   String?
  experience     ExperienceLevel?
  status         EnquiryStatus   @default(NEW)
  followUpDate   DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Parent?      @relation(fields: [organizationId, parentId], references: [organizationId, id])
  payments     Payment[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([status])
  @@index([phone])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  studentId      String?
  enquiryId      String?
  type           PaymentType
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student?     @relation(fields: [organizationId, studentId], references: [organizationId, id])
  enquiry      Enquiry?     @relation(fields: [organizationId, enquiryId], references: [organizationId, id])

  @@index([organizationId])
  @@index([studentId])
  @@index([enquiryId])
  @@index([status])
}