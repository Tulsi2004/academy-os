generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  RECEPTIONIST
  TEACHER
  ACCOUNTANT
}

enum EnquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  ADMITTED
  LOST
}

enum ExperienceLevel {
  NONE
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentType {
  REGISTRATION
  COURSE
  EVENT
  EXAM
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DROPPED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  courses      Course[]
  batches      Batch[]
  teachers     Teacher[]
  students     Student[]
  parents      Parent[]
  enquiries    Enquiry[]
  payments     Payment[]
  enrollments  Enrollment[]
  enquiryNotes EnquiryNote[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String
  role           UserRole
  clerkUserId    String?  @unique
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enquiryNotes EnquiryNote[]

  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@index([organizationId])
}

model Course {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      Batch[]
  enquiries    Enquiry[]

  @@unique([organizationId, id])
  @@index([organizationId])
}

model Teacher {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      Batch[]

  @@unique([organizationId, id])
  @@index([organizationId])
}

model Batch {
  id             String   @id @default(cuid())
  organizationId String
  courseId       String
  teacherId      String?
  name           String
  capacity       Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [organizationId, courseId], references: [organizationId, id])
  teacher      Teacher?     @relation(fields: [organizationId, teacherId], references: [organizationId, id])
  enrollments  Enrollment[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([courseId])
  @@index([teacherId])
}

model Parent {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students     Student[]
  enquiries    Enquiry[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([phone])
}

model Student {
  id             String           @id @default(cuid())
  organizationId String
  parentId       String?
  firstName      String
  lastName       String?
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  address        String?
  experience     ExperienceLevel?
  photoUrl       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent               Parent?      @relation(fields: [organizationId, parentId], references: [organizationId, id])
  payments             Payment[]
  enrollments          Enrollment[]
  convertedFromEnquiry Enquiry?     @relation("EnquiryConversion")

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([parentId])
}

model Enrollment {
  id             String           @id @default(cuid())
  organizationId String
  studentId      String
  batchId        String
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  endedAt        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [organizationId, studentId], references: [organizationId, id])
  batch        Batch        @relation(fields: [organizationId, batchId], references: [organizationId, id])

  @@unique([studentId, batchId])
  @@index([organizationId])
  @@index([studentId])
  @@index([batchId])
}

model Enquiry {
  id                 String           @id @default(cuid())
  organizationId     String
  parentId           String?
  studentName        String
  parentName         String?
  phone              String
  email              String?
  interestedIn       String?
  // Free-text `interestedIn` stays: a parent often says "something for my
  // 7-year-old". `courseId` captures a real course when they name one.
  courseId           String?
  // Set when this enquiry becomes an admission. Without it there is no way to
  // answer "how many enquiries converted this month".
  convertedStudentId String?
  experience         ExperienceLevel?
  status             EnquiryStatus    @default(NEW)
  followUpDate       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent           Parent?       @relation(fields: [organizationId, parentId], references: [organizationId, id])
  course           Course?       @relation(fields: [organizationId, courseId], references: [organizationId, id])
  convertedStudent Student?      @relation("EnquiryConversion", fields: [organizationId, convertedStudentId], references: [organizationId, id])
  payments         Payment[]
  noteEntries      EnquiryNote[]

  @@unique([organizationId, id])
  @@unique([organizationId, convertedStudentId])
  @@index([organizationId])
  @@index([status])
  @@index([phone])
  @@index([courseId])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  studentId      String?
  enquiryId      String?
  type           PaymentType
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student?     @relation(fields: [organizationId, studentId], references: [organizationId, id])
  enquiry      Enquiry?     @relation(fields: [organizationId, enquiryId], references: [organizationId, id])

  @@index([organizationId])
  @@index([studentId])
  @@index([enquiryId])
  @@index([status])
}

/// Append-only. An enquiry's notes are a history of what was said and when,
/// not a single field the last person to touch it overwrites.
model EnquiryNote {
  id             String   @id @default(cuid())
  organizationId String
  enquiryId      String
  authorId       String?
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enquiry      Enquiry      @relation(fields: [organizationId, enquiryId], references: [organizationId, id], onDelete: Cascade)
  author       User?        @relation(fields: [organizationId, authorId], references: [organizationId, id])

  @@index([organizationId])
  @@index([enquiryId])
  @@index([createdAt])
}
